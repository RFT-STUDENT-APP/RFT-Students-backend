              "  pm.expect(json).to.have.property('accessToken');",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "5) Admin registers lecturer",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{tokenAdmin}}" }
        ],
        "url": { "raw": "{{baseUrl}}/auth/register/lecturer", "host": ["{{baseUrl}}"], "path": ["auth", "register", "lecturer"] },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"firstName\": \"{{lecturerFirstName}}\",\n  \"lastName\": \"{{lecturerLastName}}\",\n  \"email\": \"{{lecturerEmail}}\",\n  \"phone\": \"{{lecturerPhone}}\",\n  \"password\": \"{{lecturerPassword}}\",\n  \"universityName\": \"{{universityName}}\"\n}"
        }
      },
      "event": [
        {
          "listen": "test",
