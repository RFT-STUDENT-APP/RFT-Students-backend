            ]
          }
        }
      ]
    },
    {
      "name": "4b) Verify class_rep email OTP",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "url": { "raw": "{{baseUrl}}/auth/verify-email", "host": ["{{baseUrl}}"], "path": ["auth", "verify-email"] },
        "body": { "mode": "raw", "raw": "{\n  \"email\": \"{{courseRepEmail}}\",\n  \"otp\": \"{{otp}}\"\n}" }
      }
    },
    {
      "name": "4c) Login as class_rep",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "url": { "raw": "{{baseUrl}}/auth/login", "host": ["{{baseUrl}}"], "path": ["auth", "login"] },
        "body": { "mode": "raw", "raw": "{\n  \"email\": \"{{courseRepEmail}}\",\n  \"password\": \"{{courseRepPassword}}\"\n}" }
      },
      "event": [
        {
