              "pm.test('Student login returns accessToken', function () {",
              "  pm.expect(json).to.have.property('accessToken');",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "4) Register class_rep (role=class_rep + access_code)",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "url": { "raw": "{{baseUrl}}/auth/register", "host": ["{{baseUrl}}"], "path": ["auth", "register"] },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"firstName\": \"{{courseRepFirstName}}\",\n  \"lastName\": \"{{courseRepLastName}}\",\n  \"email\": \"{{courseRepEmail}}\",\n  \"phone\": \"{{courseRepPhone}}\",\n  \"matricNo\": \"{{courseRepMatricNo}}\",\n  \"password\": \"{{courseRepPassword}}\",\n  \"role\": \"class_rep\",\n  \"universityName\": \"{{universityName}}\",\n  \"access_code\": \"{{accessCode}}\"\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const json = pm.response.json();",
              "pm.test('Register class_rep returns message', function () {",
